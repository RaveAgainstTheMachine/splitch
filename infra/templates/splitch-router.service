[Unit]
Description=Splitch Local AI Router & Dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/splitch
Environment=SPLITCH_CONFIG=%h/splitch/splitch.toml
ExecStart=%h/.local/bin/uv run splitch router --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
