<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.splitch.agent</string>
  <key>WorkingDirectory</key>
  <string>/path/to/splitch</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SPLITCH_NODE_ID</key>
    <string>mac-node</string>
    <key>SPLITCH_NODE_ROLE</key>
    <string>unified</string>
    <key>SPLITCH_ENGINE_URL</key>
    <string>http://127.0.0.1:8081</string>
    <key>SPLITCH_ENABLE_TOOLS</key>
    <string>0</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/splitch/.venv/bin/splitch</string>
    <string>agent</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8090</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
